# TrustedRouter key (inference runs on the confidential endpoint; fails closed)
TRUSTEDROUTER_API_KEY=
# Confidential inference host. NY Token Exchange and TrustedRouter run the same attested gateway.
TR_BASE_URL=https://api.confidential.nytokenexchange.com/v1
TR_MODEL=z-ai/glm-5.3-flash
# Context.dev key for public claim checks (optional; mock results without it)
CONTEXT_DEV_API_KEY=
PORT=4310
